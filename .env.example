# Docker Compose Environment Variables
# Copy this file as .env and fill in your actual values
# NEVER commit the .env file to version control!

MSSQL_SA_PASSWORD=YourStrongPasswordHere
CONNECTION_STRING=Server=db;Database=YourWebsiteDB;User Id=sa;Password=YourStrongPasswordHere;TrustServerCertificate=True;MultipleActiveResultSets=true
IYZIPAY_API_KEY=your-iyzipay-api-key
IYZIPAY_SECRET_KEY=your-iyzipay-secret-key
