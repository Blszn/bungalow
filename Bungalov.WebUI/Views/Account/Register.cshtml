@model Bungalov.WebUI.Models.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="auth-container">
    <div class="auth-card glass-morphism">
        <div class="auth-header text-center">
            <h1 class="premium-title">Aramıza Katılın</h1>
            <p class="subtitle">Hemen bir hesap oluşturun ve en güzel bungalovları keşfedin.</p>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="FirstName" class="form-control premium-input" placeholder="Ad" />
                        <label asp-for="FirstName">Ad</label>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="LastName" class="form-control premium-input" placeholder="Soyad" />
                        <label asp-for="LastName">Soyad</label>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control premium-input" placeholder="name@example.com" />
                        <label asp-for="Email">E-posta</label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="PhoneNumber" class="form-control premium-input" placeholder="05XX XXX XX XX" />
                        <label asp-for="PhoneNumber">Telefon</label>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control premium-input" placeholder="Şifre" />
                        <label asp-for="Password">Şifre</label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="ConfirmPassword" class="form-control premium-input" placeholder="Şifre Tekrar" />
                        <label asp-for="ConfirmPassword">Şifre Tekrar</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-premium w-100 py-3 mb-3">Hesabımı Oluştur</button>
            
            <div class="text-center">
                <p class="mb-0">Zaten bir hesabınız var mı? <a asp-action="Login" class="auth-link">Giriş Yap</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .auth-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 0;
    }

    .auth-card {
        width: 100%;
        max-width: 650px;
        padding: 3rem;
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .glass-morphism {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .premium-title {
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 0.5rem;
    }

    .subtitle {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 2.5rem;
    }

    .premium-input {
        border-radius: 12px;
        border: 1.5px solid #eee;
        padding: 1rem;
        transition: all 0.3s ease;
    }

    .premium-input:focus {
        border-color: #f39c12;
        box-shadow: 0 0 0 4px rgba(243, 156, 18, 0.1);
    }

    .btn-premium {
        background: linear-gradient(135deg, #f39c12, #d35400);
        color: white;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-premium:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(211, 84, 0, 0.3);
        color: white;
    }

    .auth-link {
        color: #d35400;
        font-weight: 600;
        text-decoration: none;
    }

    .auth-link:hover {
        text-decoration: underline;
    }
</style>
