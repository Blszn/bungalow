@model List<Bungalov.Core.Varliklar.Reservation>

@{
    ViewData["Title"] = "Takvim Yönetimi";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

<div class="row mb-4 align-items-center">
    <div class="col">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="Bungalow" asp-action="Index">Bungalovlar</a></li>
                <li class="breadcrumb-item active">Takvim Yönetimi</li>
            </ol>
        </nav>
        <h1 class="h3 mb-0">@ViewBag.BungalowName - Takvim Yönetimi</h1>
        <p class="text-muted small">Bu sayfadan bungalovun müsaitlik durumunu manuel olarak yönetebilirsiniz.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Takvim -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div id="adminCalendar"></div>
            </div>
        </div>
    </div>

    <!-- İşlem Paneli -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-dark text-white p-3 rounded-top-4">
                <h5 class="mb-0"><i class="bi bi-calendar-x me-2"></i>Tarih Aralığı Kapat</h5>
            </div>
            <div class="card-body p-4">
                <form id="blockForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bungalowId" value="@ViewBag.BungalowId" />
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">BAŞLANGIÇ TARİHİ</label>
                        <input type="date" name="checkIn" id="checkIn" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">BİTİŞ TARİHİ</label>
                        <input type="date" name="checkOut" id="checkOut" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">NOT (İSTEĞE BAĞLI)</label>
                        <textarea name="note" class="form-control" placeholder="Örn: Bakım çalışması, Özel kullanım..." rows="2"></textarea>
                    </div>
                    <button type="button" onclick="blockDates()" class="btn btn-danger w-100 py-2 fw-bold">
                        <i class="bi bi-lock-fill me-2"></i>Seçili Tarihleri Kapat
                    </button>
                    <div class="form-text mt-3">
                        <i class="bi bi-info-circle me-1"></i> Kapattığınız tarihler müşterilere "Dolu" olarak görünecektir.
                    </div>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-light p-3 rounded-top-4 border-bottom">
                <h5 class="mb-0 text-dark"><i class="bi bi-list-task me-2"></i>Aktif Bloklar</h5>
            </div>
            <div class="card-body p-3">
                @if (Model != null && Model.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            <div class="list-group-item px-0 border-bottom">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="fw-bold small text-danger">@item.CheckInDate.ToString("dd MMM") - @item.CheckOutDate.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">@item.Note</div>
                                    </div>
                                    <button onclick="unblockDates(@item.Id)" class="btn btn-sm btn-outline-secondary border-0 text-danger rounded-circle">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-check d-block fs-2 mb-2"></i>
                        <span class="small">Henüz manuel kapatılmış tarih bulunmuyor.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var calendar;
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('adminCalendar');
            calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'tr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,listMonth'
                },
                events: function(info, successCallback, failureCallback) {
                    fetch(`/Reservation/GetBookedDates?bungalowId=@ViewBag.BungalowId`)
                        .then(response => response.json())
                        .then(dates => {
                            const events = dates.map(date => ({
                                start: date,
                                allDay: true,
                                display: 'background',
                                color: '#dc3545'
                            }));
                            successCallback(events);
                        });
                }
            });
            calendar.render();
        });

        function blockDates() {
            var btn = document.querySelector('#blockForm button');
            var originalHtml = btn.innerHTML;
            
            // Tarih kontrolü
            var checkIn = document.getElementById('checkIn').value;
            var checkOut = document.getElementById('checkOut').value;
            
            if (!checkIn || !checkOut) {
                Swal.fire('Uyarı', 'Lütfen tüm tarihleri seçin.', 'warning');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> İşleniyor...';

            var formData = new FormData(document.getElementById('blockForm'));
            
            fetch('/AdminReservation/BlockDates', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('#blockForm input[name="__RequestVerificationToken"]').value
                },
                body: formData
            })
            .then(response => {
                if (!response.ok) throw new Error('Sunucu hatası');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: 'Başarılı',
                        text: data.message,
                        icon: 'success',
                        confirmButtonText: 'Tamam'
                    }).then(() => window.location.reload());
                } else {
                    // Sunucudan gelen hata mesajını detayıyla göster
                    let errorMsg = data.message;
                    if(data.detail) errorMsg += "\nDetay: " + data.detail;
                    
                    Swal.fire('Hata', errorMsg, 'error');
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Sistem Hatası', 'İşlem sırasında bir hata oluştu veya sunucuya erişilemedi.', 'error');
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            });
        }

        function unblockDates(id) {
            Swal.fire({
                title: 'Emin misiniz?',
                text: "Bu tarih kilidini kaldırmak istiyor musunuz?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Kaldır',
                cancelButtonText: 'Vazgeç'
            }).then((result) => {
                if (result.isConfirmed) {
                    var formData = new FormData();
                    formData.append('id', id);

                    fetch('/AdminReservation/UnblockDates', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('#blockForm input[name="__RequestVerificationToken"]').value
                        },
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: 'Kaldırıldı',
                                text: data.message,
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => window.location.reload());
                        }
                    });
                }
            });
        }
    </script>
}
