@model Bungalov.Core.Varliklar.Amenity

@{
    ViewData["Title"] = "Yeni Olanak Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-3 shadow-sm rounded-circle p-2 d-flex" style="width: 40px; height: 40px;">
                <i class="bi bi-arrow-left m-auto"></i>
            </a>
            <div>
                <h1 class="display-6 mb-0">Yeni Olanak Ekle</h1>
                <p class="text-muted mb-0">Bungalovlar için yeni bir özellik tanımlayın.</p>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Name" class="form-control" placeholder="Havuz, Jakuzi vb." />
                        <label asp-for="Name"><i class="bi bi-tag me-1"></i>Olanak Adı</label>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="IconCode" class="form-control pe-5" placeholder="bi-water" />
                        <label asp-for="IconCode"><i class="bi bi-grid-fill me-1"></i>İkon Kodu (bi-...) </label>
                        <button type="button" class="btn btn-link text-info position-absolute end-0 top-50 translate-middle-y me-2 z-3" 
                                data-bs-toggle="modal" data-bs-target="#iconRefModal" title="İkon Rehberi">
                            <i class="bi bi-info-circle-fill fs-4"></i>
                        </button>
                        <span asp-validation-for="IconCode" class="text-danger small"></span>
                        <div class="form-text mt-2">Örn: <code>bi-wifi</code>, <code>bi-fire</code>, <code>bi-water</code></div>
                    </div>

                    <div class="form-check form-switch mb-4 py-2">
                        <input class="form-check-input fs-5" type="checkbox" role="switch" asp-for="Status" checked>
                        <label class="form-check-label pt-1 ms-2" asp-for="Status">Aktif mi?</label>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary btn-lg py-3 shadow-sm rounded-3 fw-bold">
                            <i class="bi bi-check2-circle me-2"></i> Olanağı Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- İkon Rehberi Modalı -->
<div class="modal fade" id="iconRefModal" tabindex="-1" aria-labelledby="iconRefModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title d-flex align-items-center" id="iconRefModalLabel">
                    <i class="bi bi-grid-3x3-gap-fill me-2"></i> Kullanılabilir İkonlar
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted mb-4 small">Aşağıdaki kodları kopyalayıp "İkon Kodu" alanına yapıştırabilirsiniz. Bungalovlar için en çok tercih edilen ikonlar:</p>
                
                <div class="row g-3">
                    @{
                        var icons = new Dictionary<string, string> {
                            { "bi-wifi", "WiFi / İnternet" },
                            { "bi-tv", "Televizyon" },
                            { "bi-fire", "Şömine / Ateş" },
                            { "bi-water", "Havuz / Su" },
                            { "bi-thermometer-half", "Isıtma / Klima" },
                            { "bi-cup-hot", "Mutfak / Kahve" },
                            { "bi-car-front", "Otopark" },
                            { "bi-p-circle", "Otopark" },
                            { "bi-tree", "Doğa / Orman" },
                            { "bi-mountain", "Manzara" },
                            { "bi-snow", "Klima / Soğutma" },
                            { "bi-wind", "Vantilatör" },
                            { "bi-bicycle", "Bisiklet" },
                            { "bi-egg-fried", "Kahvaltı" },
                            { "bi-umbrella", "Plaj / Şemsiye" },
                            { "bi-shield-check", "Güvenlik" },
                            { "bi-camera-video", "Kamera" },
                            { "bi-briefcase", "Çalışma Alanı" },
                            { "bi-sun", "Güneşlenme" },
                            { "bi-house-heart", "Romantik / Balayı" },
                            { "bi-plugin", "Elektrik / Şarj" },
                            { "bi-key", "Güvenli Giriş" },
                            { "bi-music-note-beamed", "Müzik Sistemi" },
                            { "bi-stars", "Jakuzi / SPA" }
                        };
                    }

                    @foreach (var icon in icons)
                    {
                        <div class="col-6 col-sm-4 col-md-3">
                            <div class="card h-100 border-light shadow-sm text-center p-3 hover-effect" onclick="copyToClipboard('@icon.Key')" style="cursor: pointer;">
                                <i class="bi @icon.Key fs-1 text-primary mb-2"></i>
                                <div class="fw-bold small text-dark mb-1">@icon.Key</div>
                                <div class="text-muted" style="font-size: 0.7rem;">@icon.Value</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Kapat</button>
                <a href="https://icons.getbootstrap.com/" target="_blank" class="btn btn-primary rounded-3 px-4">
                    <i class="bi bi-box-arrow-up-right me-2"></i>Tüm İkonları Gör
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .hover-effect { transition: all 0.3s ease; }
    .hover-effect:hover { transform: translateY(-5px); background-color: #f8f9fa; border-color: #0d6efd !important; }
    .z-3 { z-index: 3; }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                // Opsiyonel: Kopyalandı geri bildirimi
                const input = document.querySelector('input[name="IconCode"]');
                if(input) {
                    input.value = text;
                    // Trigger input event for validation or live preview if exists
                    input.dispatchEvent(new Event('input'));
                    input.dispatchEvent(new Event('change'));
                }
                
                // Show a brief toast or change icon color?
                // For now, let's just close modal
                var modal = bootstrap.Modal.getInstance(document.getElementById('iconRefModal'));
                modal.hide();
            });
        }
    </script>
}
