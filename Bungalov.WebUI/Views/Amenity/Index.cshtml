@model IEnumerable<Bungalov.Core.Varliklar.Amenity>

@{
    ViewData["Title"] = "Olanak Yönetimi";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="display-6"><i class="bi bi-star text-primary"></i> Olanak Yönetimi</h1>
        <p class="text-muted">Bungalovlar için kullanılabilen dinamik özellikleri yönetin.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Yeni Olanak Ekle
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 py-3" style="width: 80px;">Sira</th>
                    <th class="py-3">Olanak Adı</th>
                    <th class="py-3">İkon</th>
                    <th class="py-3 text-center">Durum</th>
                    <th class="py-3 text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-info-circle display-6 d-block mb-3 text-muted"></i>
                            <p class="text-muted mb-0">Henüz hiç olanak tanımlanmamış.</p>
                        </td>
                    </tr>
                }
                else
                {
                    int counter = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">@counter++</td>
                            <td>
                                <span class="fw-bold fs-5 text-dark">@item.Name</span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                                    <i class="bi @item.IconCode fs-5"></i>
                                </span>
                                <code class="ms-2 small text-muted">@item.IconCode</code>
                            </td>
                            <td class="text-center">
                                @if (item.Status)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">Pasif</span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@item.Name silinsin mi?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 alert alert-info shadow-sm rounded-4 border-0 py-3">
    <div class="d-flex">
        <i class="bi bi-lightbulb fs-4 me-3"></i>
        <div>
            <h6 class="fw-bold mb-1">İpucu: İkon Kodları</h6>
            <p class="small mb-0 text-muted">
                İkon kodları için <a href="https://icons.getbootstrap.com/" target="_blank" class="text-primary text-decoration-none">Bootstrap Icons</a> kütüphanesini kullanın. Örn: <code>bi-water</code>, <code>bi-wifi</code>, <code>bi-fire</code>.
            </p>
        </div>
    </div>
</div>
