@model Bungalov.Core.Varliklar.Bungalow

@{
    ViewData["Title"] = "Yeni Bungalov Ekle";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-9">
        
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-3 shadow-sm rounded-circle p-2 d-flex" style="width: 40px; height: 40px;">
                <i class="bi bi-arrow-left m-auto"></i>
            </a>
            <div>
                <h1 class="display-6 mb-0">Yeni Bungalov Ekle</h1>
                <p class="text-muted mb-0">Sisteme yeni bir bungalov kaydı oluşturun.</p>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-5">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @* ══════════════ TEMEL BİLGİLER ══════════════ *@
                    <h5 class="text-primary border-bottom pb-2 mb-4"><i class="bi bi-info-circle me-2"></i>Temel Bilgiler</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Name" class="form-control" placeholder="Bungalov Adı" />
                                <label asp-for="Name">Bungalov Adı</label>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                    <option value="">Seçiniz...</option>
                                </select>
                                <label asp-for="CategoryId">Kategori</label>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-center">
                            <div class="form-check form-switch ms-3">
                                <input class="form-check-input fs-4" type="checkbox" asp-for="Status" id="statusSwitch" checked>
                                <label class="form-check-label ms-2 fw-bold text-muted" for="statusSwitch">Aktif mi?</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control" placeholder="Açıklama" style="height: 110px"></textarea>
                        <label asp-for="Description">Açıklama</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    @* ══════════════ FİYAT & FİZİKSEL ══════════════ *@
                    <h5 class="text-primary border-bottom pb-2 mb-4"><i class="bi bi-cash-stack me-2"></i>Fiyat &amp; Kapasite</h5>

                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="PricePerNight" type="number" step="0.01" min="0" class="form-control" placeholder="Gecelik Fiyat" />
                                <label asp-for="PricePerNight">Gecelik Fiyat (₺)</label>
                                <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="Capacity" type="number" min="1" class="form-control" placeholder="Kapasite" />
                                <label asp-for="Capacity">Kapasite (Kişi)</label>
                                <span asp-validation-for="Capacity" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="SizeM2" type="number" min="1" class="form-control" placeholder="Alan (m²)" />
                                <label asp-for="SizeM2">Alan (m²)</label>
                                <span asp-validation-for="SizeM2" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-floating">
                                <input asp-for="MinNights" type="number" min="1" class="form-control" placeholder="Min. Gece" />
                                <label asp-for="MinNights">Min. Konaklama (Gece)</label>
                                <span asp-validation-for="MinNights" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    @* ══════════════ KONUM BİLGİLERİ ══════════════ *@
                    <h5 class="text-primary border-bottom pb-2 mb-4"><i class="bi bi-geo-alt me-2"></i>Konum Bilgileri</h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Province" class="form-control" placeholder="İl" />
                                <label asp-for="Province"><i class="bi bi-map me-1"></i>İl</label>
                                <span asp-validation-for="Province" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="District" class="form-control" placeholder="İlçe" />
                                <label asp-for="District">İlçe</label>
                                <span asp-validation-for="District" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Neighborhood" class="form-control" placeholder="Mahalle / Köy" />
                                <label asp-for="Neighborhood">Mahalle / Köy</label>
                                <span asp-validation-for="Neighborhood" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <div class="form-floating">
                                <input asp-for="Address" class="form-control" placeholder="Tam Adres" />
                                <label asp-for="Address"><i class="bi bi-signpost me-1"></i>Tam Adres</label>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Latitude" type="number" step="any" id="latInput" class="form-control" lang="en" placeholder="Enlem" readonly />
                                <label asp-for="Latitude">Enlem (Latitude)</label>
                                <span asp-validation-for="Latitude" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-floating">
                                <input asp-for="Longitude" type="number" step="any" id="lngInput" class="form-control" lang="en" placeholder="Boylam" readonly />
                                <label asp-for="Longitude">Boylam (Longitude)</label>
                                <span asp-validation-for="Longitude" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <label class="form-label text-muted small fw-bold">HARİTA ÜZERİNDEN KONUM SEÇİN</label>
                            <div id="adminPickerMap" class="rounded-4 border shadow-sm" style="height: 350px; cursor: crosshair;"></div>
                            <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i> Harita üzerinde istediğiniz noktaya tıklayarak veya işareti sürükleyerek konumu belirleyebilirsiniz.</div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <div class="form-floating">
                                <input asp-for="Location" class="form-control" placeholder="Konum Etiketi" />
                                <label asp-for="Location">Konum Etiketi (Kısa)</label>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>
                            <div class="form-text">Ör: "Ormanlık Alan, Bolu" (Kartlarda bu isim görünür)</div>
                        </div>
                    </div>

                    @* ══════════════ ÖZELLİKLER ══════════════ *@
                    <h5 class="text-primary border-bottom pb-2 mb-4"><i class="bi bi-star me-2"></i>Olanaklar &amp; Özellikler</h5>

                    <div class="row bg-light rounded-3 p-3 mb-4 mx-0 border g-2">
                        @if (ViewBag.Amenities != null)
                        {
                            foreach (var amenity in (IEnumerable<Bungalov.Core.Varliklar.Amenity>)ViewBag.Amenities)
                            {
                                <div class="col-md-4 col-6">
                                    <div class="form-check form-switch py-2">
                                        <input class="form-check-input fs-5" type="checkbox" name="selectedAmenityIds" value="@amenity.Id" id="amenity_@amenity.Id">
                                        <label class="form-check-label pt-1 ms-2" for="amenity_@amenity.Id">
                                            <i class="bi @amenity.IconCode me-1 text-primary"></i> @amenity.Name
                                        </label>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center text-muted py-2">
                                <i class="bi bi-info-circle me-1"></i>Henüz hiç olanak tanımlanmamış. <a asp-controller="Amenity" asp-action="Create" class="text-primary text-decoration-none">Buradan ekleyin.</a>
                            </div>
                        }
                    </div>

                    @* ══════════════ RESİMLER ══════════════ *@
                    <h5 class="text-primary border-bottom pb-2 mb-4"><i class="bi bi-images me-2"></i>Görseller</h5>
                    
                    <div class="mb-4">
                        <label for="newImages" class="form-label text-muted fw-medium">Bungalov Görselleri</label>
                        <input type="file" class="form-control form-control-lg" id="newImages" name="newImages" accept="image/*" multiple />
                        <div class="form-text">Birden fazla resim seçmek için CTRL veya Shift tuşunu basılı tutun.</div>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary btn-lg py-3 shadow-sm rounded-3 fw-bold">
                            <i class="bi bi-check2-circle me-2"></i> Bungalovu Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Varsayılan Merkez (İstanbul)
            var defaultLat = 41.0082;
            var defaultLng = 28.9784;

            var map = L.map('adminPickerMap').setView([defaultLat, defaultLng], 10);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            var marker;

            function updateInputs(lat, lng) {
                document.getElementById('latInput').value = lat.toFixed(6);
                document.getElementById('lngInput').value = lng.toFixed(6);
            }

            map.on('click', function(e) {
                var lat = e.latlng.lat;
                var lng = e.latlng.lng;

                if (marker) {
                    marker.setLatLng(e.latlng);
                } else {
                    marker = L.marker(e.latlng, { draggable: true }).addTo(map);
                    marker.on('dragend', function(event) {
                        var m = event.target;
                        var position = m.getLatLng();
                        updateInputs(position.lat, position.lng);
                    });
                }
                updateInputs(lat, lng);
            });
        });
    </script>
}