@model IEnumerable<Bungalov.Core.Varliklar.Bungalow>

@{
    ViewData["Title"] = "Bungalov Listesi";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="display-6"><i class="bi bi-list-ul text-primary"></i> Bungalov Listesi</h1>
        <p class="text-muted">Sistemdeki tüm bungalovları buradan yönetebilirsiniz.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Yeni Ekle
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm rounded-4" role="alert">
        <i class="bi bi-info-circle display-4 d-block mb-3"></i>
        <h4 class="alert-heading">Henüz Bungalov Yok!</h4>
        <p class="mb-0">Sistemde kayıtlı bungalov bulunamadı. Hemen "Yeni Ekle" butonuna tıklayarak ilk bungalovunuzu ekleyin.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    @if (item.Images != null && item.Images.Any())
                    {
                        var imageList = item.Images.ToList();
                        if (imageList.Count == 1)
                        {
                            <img src="@imageList.First().ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div id="carousel-@item.Id" class="carousel slide pointer-event card-img-top" data-bs-ride="carousel" style="height: 200px;">
                                <div class="carousel-indicators">
                                    @for (int i = 0; i < imageList.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#carousel-@item.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                                    }
                                </div>
                                <div class="carousel-inner h-100">
                                    @for (int i = 0; i < imageList.Count; i++)
                                    {
                                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                            <img src="@imageList[i].ImageUrl" class="d-block w-100 h-100" alt="@item.Name" style="object-fit: cover;">
                                        </div>
                                    }
                                </div>
                                <button class="carousel-control-prev" type="button" data-bs-target="#carousel-@item.Id" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Önceki</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carousel-@item.Id" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Sonraki</span>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-house-heart text-muted" style="font-size: 4rem;"></i>
                        </div>
                    }
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                <i class="bi bi-tags"></i> @(item.Category?.CategoryName ?? "Kategorisiz")
                            </span>
                            <h4 class="text-success mb-0 fw-bold">₺@item.PricePerNight.ToString("N2") <small class="text-muted fs-6 fw-normal">/gece</small></h4>
                        </div>
                        <h4 class="card-title fw-bold">@item.Name</h4>
                    </div>
                    <div class="card-body">
                        <p class="card-text text-muted">@(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)</p>
                        
                        <ul class="list-group list-group-flush mt-3 rounded-3 overflow-hidden border">
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-light border-bottom">
                                <span><i class="bi bi-people text-secondary me-2"></i> Kapasite</span>
                                <span class="badge bg-secondary rounded-pill">@item.Capacity Kişi</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-light border-bottom">
                                <span><i class="bi bi-geo-alt text-secondary me-2"></i> Konum</span>
                                <span class="fw-medium">@item.Location</span>
                            </li>
                            <li class="list-group-item d-flex gap-2 justify-content-center bg-light">
                                @if (item.HasJacuzzi) { <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="bi bi-droplet"></i> Jakuzi</span> }
                                @if (item.HasPool) { <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="bi bi-water"></i> Havuz</span> }
                                @if (item.IsWifiAvailable) { <span class="badge bg-dark-subtle text-dark border border-dark-subtle"><i class="bi bi-wifi"></i> WiFi</span> }
                            </li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-4">
                        <div class="d-flex justify-content-between gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary flex-grow-1">
                                <i class="bi bi-pencil-square"></i> Düzenle
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@item.Name isimli bungalovu silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash3"></i> Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
