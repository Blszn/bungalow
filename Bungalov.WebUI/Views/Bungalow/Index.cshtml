@model IEnumerable<Bungalov.Core.Varliklar.Bungalow>

@{
    ViewData["Title"] = "Bungalov Listesi";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="premium-title mb-0">Bungalovları Keşfedin</h1>
        <p class="text-muted">Size en uygun konaklama seçeneklerini filtreleyerek bulun.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-circle me-2"></i> Yeni Ekle
            </a>
        </div>
    }
</div>

<div class="row">
    <!-- Sidebar - Filtreler ve Kategoriler -->
    <div class="col-lg-3">
        <!-- Kategori Listesi ViewComponent -->
        @await Component.InvokeAsync("CategoryList", new { selectedCategoryId = ViewBag.CategoryId })
        
        <!-- Detaylı Filtreleme -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
                <h5 class="fw-bold mb-0"><i class="bi bi-funnel text-primary me-2"></i>Filtrele</h5>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <input type="hidden" name="search" value="@ViewBag.Search" />
                    <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Giriş Tarihi</label>
                        <input type="date" name="checkIn" value="@ViewBag.CheckIn" class="form-control border-0 bg-light shadow-none">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Çıkış Tarihi</label>
                        <input type="date" name="checkOut" value="@ViewBag.CheckOut" class="form-control border-0 bg-light shadow-none">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Minimum Kapasite</label>
                        <select name="minCapacity" class="form-select border-0 bg-light shadow-none">
                            <option value="">Hepsi</option>
                            <!option value="2" @(ViewBag.MinCapacity == 2 ? "selected" : "")>En az 2 Kişi</!option>
                            <!option value="4" @(ViewBag.MinCapacity == 4 ? "selected" : "")>En az 4 Kişi</!option>
                            <!option value="6" @(ViewBag.MinCapacity == 6 ? "selected" : "")>En az 6 Kişi</!option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold mb-3">Olanaklar</label>
                        <div class="amenities-filter-list bg-light p-3 rounded-3" style="max-height: 300px; overflow-y: auto;">
                            @if (ViewBag.AllAmenities != null)
                            {
                                var selectedIds = (int[])ViewBag.SelectedAmenityIds;
                                foreach (var amenity in (IEnumerable<Bungalov.Core.Varliklar.Amenity>)ViewBag.AllAmenities)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="amenityIds" value="@amenity.Id" id="filter_@amenity.Id" @(selectedIds.Contains(amenity.Id) ? "checked" : "")>
                                        <label class="form-check-label small" for="filter_@amenity.Id">
                                            <i class="bi @amenity.IconCode text-primary-emphasis me-1"></i> @amenity.Name
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <small class="text-muted">Özellik bulunamadı.</small>
                            }
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 py-2 border-0 shadow-sm"><i class="bi bi-search me-2"></i>Uygula</button>
                    <a asp-action="Index" class="btn btn-link text-secondary w-100 mt-2 text-decoration-none small">Temizle</a>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Ana İçerik - Listeleme -->
    <div class="col-lg-9">
        <!-- Arama Çubuğu -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="card-body">
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
                    <input type="hidden" name="minCapacity" value="@ViewBag.MinCapacity" />
                    @if (ViewBag.SelectedAmenityIds != null)
                    {
                        foreach (var id in (int[])ViewBag.SelectedAmenityIds)
                        {
                            <input type="hidden" name="amenityIds" value="@id" />
                        }
                    }
                    
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 border-end-0 ps-0 shadow-none" placeholder="Konum veya bungalov adı...">
                        <span class="input-group-text bg-white border-start-0 border-end-0"><i class="bi bi-calendar-event text-muted"></i></span>
                        <input type="date" name="checkIn" value="@ViewBag.CheckIn" class="form-control border-start-0 border-end-0 shadow-none border-0" style="max-width: 150px;">
                        <input type="date" name="checkOut" value="@ViewBag.CheckOut" class="form-control border-start-0 border-end-0 shadow-none border-0" style="max-width: 150px;">
                        <button class="btn btn-primary px-4" type="submit">Ara</button>
                    </div>
                </form>
            </div>
        </div>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center py-5 shadow-sm rounded-4" role="alert">
        <i class="bi bi-emoji-frown display-4 d-block mb-3 text-muted"></i>
        <h4 class="fw-bold">Sonuç Bulunamadı</h4>
        <p class="text-muted mb-0">Aradığınız kriterlere uygun bir bungalov bulamadık. Lütfen filtreleri esnetmeyi deneyin.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bungalow-card">
                    @if (item.Images != null && item.Images.Any())
                    {
                        var imageList = item.Images.ToList();
                        if (imageList.Count == 1)
                        {
                            <img src="@imageList.First().ImageUrl" class="card-img-top" alt="@item.Name" style="height: 220px; object-fit: cover;">
                        }
                        else
                        {
                            <div id="carousel-@item.Id" class="carousel slide pointer-event card-img-top" data-bs-ride="carousel" style="height: 220px;">
                                <div class="carousel-indicators">
                                    @for (int i = 0; i < imageList.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#carousel-@item.Id" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                                    }
                                </div>
                                <div class="carousel-inner h-100">
                                    @for (int i = 0; i < imageList.Count; i++)
                                    {
                                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                            <img src="@imageList[i].ImageUrl" class="d-block w-100 h-100" alt="@item.Name" style="object-fit: cover;">
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                            <i class="bi bi-house-heart text-muted opacity-25" style="font-size: 5rem;"></i>
                        </div>
                    }
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-tags"></i> @(item.Category?.CategoryName ?? "Kategorisiz")
                            </span>
                            @if (User.IsInRole("Admin") && !item.Status)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 ms-2">
                                    <i class="bi bi-eye-slash-fill"></i> Pasif
                                </span>
                            }
                            <h5 class="text-success mb-0 fw-bold">₺@item.PricePerNight.ToString("N0") <small class="text-muted fs-6 fw-normal">/gece</small></h5>
                        </div>
                        <h5 class="card-title fw-bold mb-1">@item.Name</h5>
                        <p class="small text-muted mb-0"><i class="bi bi-geo-alt me-1"></i>
                            @if (!string.IsNullOrEmpty(item.Province)) { @item.Province @(string.IsNullOrEmpty(item.District) ? "" : " / " + item.District) }
                            else { @item.Location }
                        </p>
                    </div>
                    <div class="card-body pt-3">
                        <div class="bg-light rounded-3 p-3">
                            <div class="row g-2">
                                <div class="col-6 small text-muted"><i class="bi bi-people me-2"></i>@item.Capacity Kişi</div>
                                <div class="col-6 small text-muted text-end"><i class="bi bi-rulers me-2"></i>@item.SizeM2 m²</div>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex flex-wrap gap-2">
                                @if (item.Amenities != null && item.Amenities.Any())
                                {
                                    @foreach (var amenity in item.Amenities)
                                    {
                                        <span class="badge bg-white text-dark border shadow-sm py-2 px-3 fw-normal rounded-3 d-flex align-items-center">
                                            <i class="bi @amenity.IconCode text-primary me-2"></i> @amenity.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <small class="text-muted fst-italic">Özellik belirtilmedi</small>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-4">
                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary py-2 rounded-3 shadow-sm mb-1">
                                <i class="bi bi-eye me-2"></i> Detayları İncele
                            </a>
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="d-flex justify-content-between gap-2 mt-2 border-top pt-3">
                                 <a asp-controller="AdminReservation" asp-action="Calendar" asp-route-bungalowId="@item.Id" class="btn btn-outline-dark btn-sm" title="Takvim Yönetimi">
                                    <i class="bi bi-calendar3"></i> Yönet
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm flex-grow-1 border-2">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@item.Name isimli bungalovu silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm border-2">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>
</div>

<style>
    .bungalow-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .bungalow-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    .amenities-filter-list::-webkit-scrollbar {
        width: 5px;
    }
    .amenities-filter-list::-webkit-scrollbar-thumb {
        background: #dee2e6;
        border-radius: 10px;
    }
</style>
