@model Bungalov.Core.Varliklar.Category

@{
    ViewData["Title"] = "Yeni Kategori Ekle";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-8">
        
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary me-3 shadow-sm rounded-circle p-2 d-flex" style="width: 40px; height: 40px;">
                <i class="bi bi-arrow-left m-auto"></i>
            </a>
            <div>
                <h1 class="display-6 mb-0">Yeni Kategori Ekle</h1>
                <p class="text-muted mb-0">Sisteme yeni bir kategori kaydı oluşturun.</p>
            </div>
        </div>

        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-body p-5">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="CategoryName" class="form-control" placeholder="Kategori Adı" />
                        <label asp-for="CategoryName">Kategori Adı</label>
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea asp-for="Description" class="form-control" placeholder="Açıklama" style="height: 100px"></textarea>
                        <label asp-for="Description">Açıklama</label>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label for="imageFile" class="form-label text-primary fw-medium"><i class="bi bi-image me-2"></i>Kategori Resmi</label>
                        <input type="file" class="form-control form-control-lg" id="imageFile" name="imageFile" accept="image/*" />
                        <div class="form-text">Önerilen boyut: 800x600 piksel. JPEG veya PNG formatında.</div>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary btn-lg py-3 shadow-sm rounded-3 fw-bold">
                            <i class="bi bi-check2-circle me-2"></i> Kategoriyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
