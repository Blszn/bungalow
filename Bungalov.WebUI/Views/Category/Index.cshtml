@model IEnumerable<Bungalov.Core.Varliklar.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="display-6"><i class="bi bi-tags text-primary"></i> Kategori Yönetimi</h1>
        <p class="text-muted">Bungalovlarınızı sınıflandırmak için kategorileri buradan yönetebilirsiniz.</p>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle me-2"></i> Yeni Kategori
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm rounded-4" role="alert">
        <i class="bi bi-info-circle display-4 d-block mb-3"></i>
        <h4 class="alert-heading">Henüz Kategori Yok!</h4>
        <p class="mb-0">Sistemde hiçbir kategori bulunamadı. "Yeni Kategori" butonuna tıklayarak ilk kategorinizi oluşturun.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.CategoryName" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@item.CategoryName</h5>
                        <p class="card-text text-muted">@(string.IsNullOrEmpty(item.Description) ? "Açıklama yok." : (item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description))</p>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-4">
                        <div class="d-flex justify-content-between gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary flex-grow-1">
                                <i class="bi bi-pencil-square"></i> Düzenle
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@item.CategoryName kategorisini silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="bi bi-trash3"></i> Sil
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
