@{
    ViewData["Title"] = "Hata Oluştu - Rivora";
    Layout = "_Layout";
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="error-container p-5 shadow-lg rounded-4 bg-white border-0">
                <div class="display-1 text-danger mb-4">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <h1 class="fw-bold text-dark mb-3">Bir Hata Oluştu!</h1>
                <p class="lead text-secondary mb-5">
                    Üzgünüz, şu anda isteğinizi gerçekleştiremiyoruz. Teknik ekibimiz durumdan haberdar edildi.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                        <i class="bi bi-house-door me-2"></i>Ana Sayfa
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg px-5 rounded-pill shadow-sm">
                        <i class="bi bi-arrow-left me-2"></i>Geri Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .error-container {
        transition: transform 0.3s ease;
    }
    .error-container:hover {
        transform: translateY(-5px);
    }
</style>
