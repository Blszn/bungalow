@model Reservation

@{
    ViewData["Title"] = "Ödeme";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-primary text-white p-4 pt-5 text-center">
                    <h2 class="fw-bold mb-0">Güvenli Ödeme</h2>
                    <p class="text-white-50">Ödemenizi kredi kartı veya banka kartı ile tamamlayabilirsiniz.</p>
                </div>
                <div class="card-body p-5">
                    <div class="row g-4 mb-5">
                        <div class="col-md-6 border-end">
                            <h6 class="text-muted small fw-bold text-uppercase mb-3">Rezervasyon Bilgileri</h6>
                            <h5 class="fw-bold mb-1">@Model.Bungalow.Name</h5>
                            <p class="text-muted small mb-0">@Model.CheckInDate.ToLocalTime().ToString("dd MMM") - @Model.CheckOutDate.ToLocalTime().ToString("dd MMM yyyy")</p>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-muted small fw-bold text-uppercase mb-3">Tutar</h6>
                            <h4 class="fw-bold text-success mb-0">₺@Model.TotalPrice.ToString("N2")</h4>
                        </div>
                    </div>

                    <div id="iyzipay-checkout-form" class="responsive">
                        @Html.Raw(ViewBag.CheckoutFormContent)
                    </div>
                </div>
                <div class="card-footer bg-light p-4 border-0 text-center">
                    <div class="d-flex align-items-center justify-content-center text-muted small">
                        <i class="bi bi-shield-lock text-success fs-4 me-2"></i>
                        <span>256-bit SSL şifreleme ile ödemeleriniz güvende.</span>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    Ödeme işlemi iyzico (Pay with iyzico) altyapısı kullanılarak gerçekleştirilmektedir.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // iZico scripts are already in the content
    </script>
}
