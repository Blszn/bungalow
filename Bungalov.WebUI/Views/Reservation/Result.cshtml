@model Bungalov.Core.Varliklar.Reservation

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            @if (ViewBag.Success == true)
            {
                <div class="card border-0 shadow-lg rounded-4 p-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success display-1"></i>
                    </div>
                    <h1 class="fw-bold mb-3">Ödeme Başarılı!</h1>
                    <p class="text-muted fs-5 mb-4">Rezervasyonunuz onaylandı. Konaklama detayları aşağıdadır.</p>
                    
                    <div class="bg-light rounded-4 p-4 text-start mb-4">
                        <div class="row g-3">
                            <div class="col-6">
                                <small class="text-muted d-block">Bungalov</small>
                                <span class="fw-bold">@Model?.Bungalow?.Name</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Tutar</small>
                                <span class="fw-bold text-primary">₺@Model?.TotalPrice.ToString("N2")</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Giriş Tarihi</small>
                                <span class="fw-bold">@Model?.CheckInDate.ToLocalTime().ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">Çıkış Tarihi</small>
                                <span class="fw-bold">@Model?.CheckOutDate.ToLocalTime().ToString("dd MMM yyyy")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model?.PaymentId))
                            {
                                <div class="col-12 border-top pt-2">
                                    <small class="text-muted d-block">İşlem Numarası (iZico)</small>
                                    <span class="font-monospace small">@Model.PaymentId</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a asp-controller="Profile" asp-action="Index" class="btn btn-primary btn-lg px-5 rounded-pill">Rezervasyonlarım</a>
                        <a asp-controller="Bungalow" asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 rounded-pill">Ana Sayfa</a>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-lg rounded-4 p-5">
                    <div class="mb-4">
                        <i class="bi bi-x-circle-fill text-danger display-1"></i>
                    </div>
                    <h1 class="fw-bold mb-3">Ödeme Başarısız</h1>
                    <p class="text-muted fs-5 mb-4">Üzgünüz, ödeme işlemi sırasında bir hata oluştu veya işlem iptal edildi.</p>
                    
                    @if (!string.IsNullOrEmpty(ViewBag.Message))
                    {
                        <div class="alert alert-danger mb-4">
                            <strong>Hata Detayı:</strong> @ViewBag.Message
                        </div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="javascript:history.back()" class="btn btn-primary btn-lg px-5 rounded-pill">Tekrar Dene</a>
                        <a asp-controller="Bungalow" asp-action="Index" class="btn btn-outline-secondary btn-lg px-5 rounded-pill">Ana Sayfa</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
