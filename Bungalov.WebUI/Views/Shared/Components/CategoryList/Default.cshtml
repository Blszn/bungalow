@model IEnumerable<Bungalov.Core.Varliklar.Category>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-2">
        <h5 class="fw-bold mb-0"><i class="bi bi-tags text-primary me-2"></i>Kategoriler</h5>
    </div>
    <div class="card-body">
        <ul class="list-group list-group-flush">
            <li class="list-group-item px-0 border-0">
                <a href="@Url.Action("Index", "Bungalow")" 
                   class="text-decoration-none @(ViewBag.SelectedCategoryId == null ? "text-primary fw-bold" : "text-dark")">
                    <i class="bi bi-chevron-right small me-1"></i> Tüm Bungalovlar
                </a>
            </li>
            @foreach (var category in Model)
            {
                <li class="list-group-item px-0 border-0">
                    <a href="@Url.Action("Index", "Bungalow", new { categoryId = category.Id })" 
                       class="text-decoration-none @(ViewBag.SelectedCategoryId == category.Id ? "text-primary fw-bold" : "text-dark")">
                        <i class="bi bi-chevron-right small me-1"></i> @category.CategoryName
                    </a>
                </li>
            }
        </ul>
    </div>
</div>
