<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rivora Bungalov</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar-brand {
            font-weight: 700;
            color: #2c3e50 !important;
        }
        .main-container {
            margin-top: 30px;
            margin-bottom: 50px;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="logo-icon me-2">
                        <i class="bi bi-house-heart-fill"></i>
                    </div>
                    <span>Rivora</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-controller="Bungalow" asp-action="Index">Bungalovlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-danger" asp-controller="Review" asp-action="QuickTest"><i class="bi bi-star-fill me-1"></i> Puanla (Sunum Test)</a>
                        </li>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-medium" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    Yönetim Paneli
                                </a>
                                <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                    <li><a class="dropdown-item fw-bold text-primary" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Category" asp-action="Index">Kategoriler</a></li>
                                    <li><a class="dropdown-item" asp-controller="Amenity" asp-action="Index">Olanaklar</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Reviews">Değerlendirmeler</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Bungalow" asp-action="Create">Yeni Bungalov Ekle</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item fw-bold text-success" asp-controller="Admin" asp-action="Chat"><i class="bi bi-chat-dots me-2"></i>Canlı Destek</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-light border" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 text-primary"></i>
                                    <span class="fw-semibold">Hesabım</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3 mt-2">
                                    <li class="px-3 py-2 small text-muted border-bottom mb-2">Hoş geldin, @User.Identity.Name</li>
                                    <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Profil Bilgilerim</a></li>
                                    @if (!User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-calendar-check me-2"></i>Rezervasyonlarım</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-medium px-3" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Register">Üye Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            &copy; 2026 - Rivora bungalow
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    @if (!User.IsInRole("Admin"))
    {
        @await Html.PartialAsync("_ChatWidgetPartial")
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
